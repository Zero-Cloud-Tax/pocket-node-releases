---
title: Pocket Node Architecture
---
flowchart TD
    subgraph Clients["Client Layer"]
        CC[Continue.dev]
        OC[OpenAI-compatible client]
    end

    subgraph Gateway["Neo — Gateway Host (homelab x86)"]
        direction TB
        GATE["Edge Gate\nFastAPI :4001\nfold6_preflight_thermal_v2\nPhase 9.8"]
        LLMR["LiteLLM Router\nDocker :4000\nmodel alias registry"]
        DLOG["Decision Log\n.jsonl on disk"]
    end

    subgraph CapCheck["Pre-Flight Check (per request)"]
        direction LR
        CAPS["GET /capabilities\n← Fold6 :11434"]
        THERMAL["thermal_zone temp\neligible_for_inference\nlast_inference_at"]
        CAPS --> THERMAL
    end

    subgraph Tier1["Tier 1 — Fold6"]
        F6["Samsung Galaxy Z Fold6\nOllama RC2\nVulkan + OpenCL\ngpu_layers=39\nSmolLM3 3.1B Q4_0\n~13+ TPS\n:11434"]
    end

    subgraph Tier2["Tier 2 — Mac Studio"]
        MS["Mac Studio\nOllama\nHigher-capacity\nfallback\n:11434"]
    end

    subgraph Tier3["Tier 3 — Moolah"]
        MO["Moolah node\nOllama\nSecond fallback\n:11434"]
    end

    CC -->|POST /v1/chat/completions| GATE
    OC -->|POST /v1/chat/completions| GATE

    GATE -->|"1. poll before Tier-1 route"| CAPS
    THERMAL -->|"eligible + temp < 65C"| GATE

    GATE -->|"allow_fold6\n[small prompt, eligible, cool]"| LLMR
    GATE -->|"bypass_oversized\n[>8000 chars / >12000 bytes / >5 msgs]"| LLMR
    GATE -->|"bypass_thermal\n[temp >=65C or eligible=false]"| LLMR
    GATE -->|"bypass_tools\n[tool_calls present]"| LLMR
    GATE -->|"bypass_model_not_loaded\n[/capabilities unreachable]"| LLMR

    GATE --> DLOG

    LLMR -->|"allow_fold6"| F6
    LLMR -->|"bypass_* routes"| MS
    MS -->|"unavailable / blackhole"| MO

    F6 -.->|"SSE stream / completion\nx-edge-gate-route header"| GATE
    MS -.->|"SSE stream / completion"| GATE
    MO -.->|"completion"| GATE

    GATE -.->|"response"| CC
    GATE -.->|"response"| OC

