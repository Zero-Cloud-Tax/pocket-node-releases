# pocket-edge-gate environment file
# Phase 9.8 - Fold6 thermal routing gate
#
# Copy this file to gate.env and fill in your values.
# NEVER commit the filled-in gate.env to version control.
#
# The gate does not need an API key — it passes the client's
# Authorization header through to LiteLLM unchanged.
# Store the LiteLLM master key in your LiteLLM configuration only.

# Bind the gate to your gateway node's Tailscale IP
GATE_HOST=[YOUR-GATEWAY-TAILSCALE-IP]
GATE_PORT=4001

# Python runtime settings
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# Optional: override hardcoded defaults from gate.py (Phase 10+)
# LITELLM_BASE=http://[YOUR-GATEWAY-TAILSCALE-IP]:4000
# FOLD6_CAPABILITIES_URL=http://[YOUR-FOLD6-TAILSCALE-IP]:11434/capabilities
# FOLD6_MAX_CHARS=8000
# FOLD6_MAX_MESSAGES=5
# FOLD6_THERMAL_THRESHOLD_C=65
